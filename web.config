<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================================
  REDCap Redirect - IIS web.config (URL Rewrite)
================================================================================

PURPOSE:
  When IIS receives a request for a REDCap URL whose version directory no
  longer exists on disk (e.g. /redcap_v8.1.0/index.php?pid=1234), this rule
  rewrites the request internally to redcap_redirect.php, which queries the
  database for the current REDCap version and issues a 302 redirect to the
  correct path.

REQUIREMENTS:
  • IIS 7.5 or later
  • URL Rewrite Module 2.x  (free download from Microsoft:
      https://www.iis.net/downloads/microsoft/url-rewrite)
  • PHP configured as a FastCGI handler in IIS
  • redcap_redirect.php present in the REDCap web root

INSTALLATION:
  Option A – Merge into an existing web.config:
    If you already have a web.config in your REDCap web root, copy the
    <rule> element (and the enclosing <rewrite><rules> structure if not
    already present) into your existing <system.webServer> section.

  Option B – New web.config:
    Place this file as-is in your REDCap web root directory.

NOTE ON SUBDIRECTORY INSTALLS:
  If REDCap is installed at a sub-path (e.g. https://example.edu/redcap/),
  the REQUEST_URI pattern below still works without modification because it
  matches anywhere in the URI. The rewrite target "/redcap_redirect.php"
  should be updated to "/redcap/redcap_redirect.php" in that case.

NOTE ON QUERY STRINGS:
  appendQueryString="false" is intentional. redcap_redirect.php reconstructs
  the full original URI (including query string) from $_SERVER['REQUEST_URI'],
  so passing the query string again via the rewrite would double it.

CREDIT:
  Original IIS configuration reported by Tony Jin in the REDCap Community:
  https://redcap.vumc.org/community/post.php?id=73262
================================================================================
-->
<configuration>
    <system.webServer>

        <rewrite>
            <rules>
                <!--
                    Rule: Redirect outdated REDCap version paths
                    ─────────────────────────────────────────────
                    Conditions (ALL must be true):
                      1. The requested path is NOT an existing file on disk.
                      2. The requested path is NOT an existing directory on disk.
                      3. The URI contains a REDCap version segment: redcap_vX.Y.Z

                    Action:
                      Internally rewrite to redcap_redirect.php for processing.
                      stopProcessing="true" prevents any further rules from firing.
                -->
                <rule name="Redirect outdated REDCap version paths"
                      enabled="true"
                      stopProcessing="true">

                    <!-- Match any request URI -->
                    <match url="^(.+)$" />

                    <conditions logicalGrouping="MatchAll">
                        <!-- Condition 1: file must not exist on disk -->
                        <add input="{REQUEST_FILENAME}"
                             matchType="IsFile"
                             negate="true" />

                        <!-- Condition 2: directory must not exist on disk -->
                        <add input="{REQUEST_FILENAME}"
                             matchType="IsDirectory"
                             negate="true" />

                        <!-- Condition 3: URI must look like a versioned REDCap path -->
                        <add input="{REQUEST_URI}"
                             pattern="^.*\/redcap_v(\d+\.\d+\.\d+)\/.*$" />
                    </conditions>

                    <!--
                        Rewrite (not redirect) to the PHP handler script.
                        Change the url value if REDCap is in a sub-directory,
                        e.g. url="/redcap/redcap_redirect.php"
                    -->
                    <action type="Rewrite"
                            url="/redcap_redirect.php"
                            appendQueryString="false" />
                </rule>
            </rules>
        </rewrite>

        <!--
            Optional: ensure PHP files are handled by the FastCGI handler.
            Remove or adjust this section if your IIS already has PHP
            configured at the server level.
        -->
        <!--
        <handlers>
            <add name="PHP_via_FastCGI"
                 path="*.php"
                 verb="GET,HEAD,POST"
                 modules="FastCgiModule"
                 scriptProcessor="C:\Program Files\PHP\v8.2\php-cgi.exe"
                 resourceType="Either" />
        </handlers>
        -->

    </system.webServer>
</configuration>
